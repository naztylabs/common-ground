{
  "name": "common-ground-knowledge",
  "version": "0.5.0-beta.0",
  "description": "An open-source framework for shared, evidence-backed repository knowledge across coding agents",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cground": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run schema",
    "demo": "npm run build && node scripts/demo.mjs",
    "schema": "npm run build && node scripts/schema.mjs",
    "release:pack": "npm test && npm run demo && node scripts/release-pack.mjs",
    "measure:context": "npm run build && node scripts/measure-context.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "contributors": [
    {
      "name": "Nazty Labs"
    }
  ]
}
