{
  "$ref": "#/definitions/knowledge",
  "definitions": {
    "knowledge": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "pillars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 3,
                "maxLength": 100
              },
              "scope": {
                "type": "string",
                "minLength": 12,
                "maxLength": 800
              },
              "excludes": {
                "type": "string",
                "minLength": 3,
                "maxLength": 800
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 30
              },
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "facts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 320
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "$ref": "#/definitions/knowledge/properties/pillars/items/properties/paths/items"
                          },
                          "quote": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1200
                          }
                        },
                        "required": [
                          "path",
                          "quote"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1,
                      "maxItems": 8
                    }
                  },
                  "required": [
                    "id",
                    "statement",
                    "evidence"
                  ],
                  "additionalProperties": false
                }
              },
              "sources": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "title",
              "scope",
              "excludes",
              "paths",
              "revision",
              "facts",
              "sources"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "pillars"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
