{
  "$ref": "#/definitions/knowledge",
  "definitions": {
    "knowledge": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "pillars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 3,
                "maxLength": 100
              },
              "scope": {
                "type": "string",
                "minLength": 12,
                "maxLength": 800
              },
              "excludes": {
                "type": "string",
                "minLength": 3,
                "maxLength": 800
              },
              "chapters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "$ref": "#/definitions/knowledge/properties/pillars/items/properties/id"
                    },
                    "title": {
                      "$ref": "#/definitions/knowledge/properties/pillars/items/properties/title"
                    },
                    "scope": {
                      "$ref": "#/definitions/knowledge/properties/pillars/items/properties/scope"
                    },
                    "excludes": {
                      "$ref": "#/definitions/knowledge/properties/pillars/items/properties/excludes"
                    },
                    "paths": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "maxItems": 30
                    },
                    "revision": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "facts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "$ref": "#/definitions/knowledge/properties/pillars/items/properties/id"
                          },
                          "statement": {
                            "type": "string",
                            "minLength": 8,
                            "maxLength": 320
                          },
                          "evidence": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "path": {
                                  "$ref": "#/definitions/knowledge/properties/pillars/items/properties/chapters/items/properties/paths/items"
                                },
                                "quote": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 1200
                                }
                              },
                              "required": [
                                "path",
                                "quote"
                              ],
                              "additionalProperties": false
                            },
                            "minItems": 1,
                            "maxItems": 8
                          },
                          "sourceScope": {
                            "type": "array",
                            "items": {
                              "$ref": "#/definitions/knowledge/properties/pillars/items/properties/chapters/items/properties/paths/items"
                            },
                            "minItems": 1
                          },
                          "dependsOn": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$"
                            },
                            "default": []
                          }
                        },
                        "required": [
                          "id",
                          "statement",
                          "evidence",
                          "sourceScope"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "sources": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "dependencyFingerprints": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "default": {}
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "scope",
                    "excludes",
                    "paths",
                    "revision",
                    "facts",
                    "sources"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "title",
              "scope",
              "excludes",
              "chapters"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "pillars"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
