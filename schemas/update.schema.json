{
  "$ref": "#/definitions/update",
  "definitions": {
    "update": {
      "type": "object",
      "properties": {
        "chapterId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$"
        },
        "factIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "minItems": 1
        },
        "touchedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chapterId": {
                "$ref": "#/definitions/update/properties/chapterId"
              },
              "expectedRevision": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "invalidatedFactIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reviewedFactIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "facts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "$ref": "#/definitions/update/properties/factIds/items"
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 320
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "$ref": "#/definitions/update/properties/touchedPaths/items"
                          },
                          "quote": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1200
                          }
                        },
                        "required": [
                          "path",
                          "quote"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1,
                      "maxItems": 8
                    },
                    "sourceScope": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/update/properties/touchedPaths/items"
                      },
                      "minItems": 1
                    },
                    "dependsOn": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$"
                      },
                      "default": []
                    }
                  },
                  "required": [
                    "id",
                    "statement",
                    "evidence",
                    "sourceScope"
                  ],
                  "additionalProperties": false
                }
              },
              "reason": {
                "type": "string",
                "minLength": 12,
                "maxLength": 1000
              }
            },
            "required": [
              "chapterId",
              "expectedRevision",
              "invalidatedFactIds",
              "reviewedFactIds",
              "facts",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "chapterId",
        "touchedPaths",
        "reviews"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
