{
  "schemaVersion": 1,
  "pillars": [
    {
      "id": "knowledge-engine",
      "title": "Knowledge Engine",
      "scope": "Pillar records, evidence validation, freshness, and atomic knowledge revision rules.",
      "excludes": "Repository initialization and MCP or CLI presentation.",
      "paths": [
        "src/model.ts",
        "src/store.ts",
        "schemas"
      ],
      "revision": 1,
      "facts": [
        {
          "id": "registry-schema",
          "statement": "The registry uses schemaVersion 1 and contains an array of pillars.",
          "evidence": [
            {
              "path": "src/model.ts",
              "quote": "schemaVersion: z.literal(1), pillars: z.array(Pillar)"
            }
          ]
        },
        {
          "id": "fact-limit",
          "statement": "Each fact statement is limited to 320 characters and requires at least one evidence quote.",
          "evidence": [
            {
              "path": "src/model.ts",
              "quote": "statement: z.string().trim().min(8).max(320), evidence: z.array(Evidence).min(1).max(8)"
            }
          ]
        },
        {
          "id": "complete-review",
          "statement": "Routine updates require the IDs of every existing fact in reviewedFactIds.",
          "evidence": [
            {
              "path": "src/store.ts",
              "quote": "throw new Error('Every existing fact must be reviewed.')"
            }
          ]
        },
        {
          "id": "atomic-replacement",
          "statement": "Shared knowledge writes rename a temporary file over knowledge.json under a writer lock.",
          "evidence": [
            {
              "path": "src/store.ts",
              "quote": "await fs.rename(tmp, this.file(name))"
            }
          ]
        },
        {
          "id": "no-routine-growth",
          "statement": "Routine fact updates reject facts with IDs absent from the current pillar.",
          "evidence": [
            {
              "path": "src/store.ts",
              "quote": "throw new Error('New facts require developer-reviewed bootstrap/admission; routine updates cannot grow knowledge.')"
            }
          ]
        }
      ],
      "sources": {
        "schemas/knowledge.schema.json": "3de2ccef2c008d163eab91c133abbe104fe013f15146084a29edf0142699e5d9",
        "schemas/update.schema.json": "73bfa09f1bc8c264879f142ea811ddd18fc208cf14cd769387deb4fa642f85a0",
        "src/model.ts": "2c9c63c3a57097085e9905c362f1488323c93e88217d6f65b46faa1c4cf54f99",
        "src/store.ts": "090a338a4ac361ecf25c9928d9cd14bf2cf1d28ca3be1a0da78cef1cabbb6e82"
      }
    },
    {
      "id": "repository-setup",
      "title": "Repository Setup",
      "scope": "Bounded pillar discovery and managed repository instruction and MCP configuration setup.",
      "excludes": "Knowledge revision transactions and agent tool execution.",
      "paths": [
        "src/init.ts"
      ],
      "revision": 1,
      "facts": [
        {
          "id": "bounded-discovery",
          "statement": "Initialization discovery walks at most 1,500 filesystem entries.",
          "evidence": [
            {
              "path": "src/init.ts",
              "quote": "const scan = await store.walk([], 1500);"
            }
          ]
        },
        {
          "id": "existing-pillars",
          "statement": "Initialization preserves an existing registry and skips new pillar discovery.",
          "evidence": [
            {
              "path": "src/init.ts",
              "quote": "existingRegistry:true, message:'Existing pillars preserved. No new discovery or pillar creation.'"
            }
          ]
        },
        {
          "id": "copilot-adapter",
          "statement": "Initialization adds managed root AGENTS.md guidance and a Copilot instruction link.",
          "evidence": [
            {
              "path": "src/init.ts",
              "quote": "await managed(store,'AGENTS.md',rules);"
            }
          ]
        },
        {
          "id": "stdio-config",
          "statement": "The VS Code MCP entry launches cground serve with the workspace folder as root.",
          "evidence": [
            {
              "path": "src/init.ts",
              "quote": "const entry = { type:'stdio', command:'cground', args:['serve','--root','${workspaceFolder}'] };"
            }
          ]
        }
      ],
      "sources": {
        "src/init.ts": "573bc8e00d88e647f84c10179931447a7cbc9d045363e49fee57239944addaf5"
      }
    },
    {
      "id": "agent-interface",
      "title": "Agent Interface",
      "scope": "CLI operator commands, local stdio MCP tools, and bounded keyword retrieval.",
      "excludes": "Persistence implementation and repository discovery.",
      "paths": [
        "src/cli.ts",
        "src/server.ts"
      ],
      "revision": 1,
      "facts": [
        {
          "id": "stdio-transport",
          "statement": "The MCP service connects through StdioServerTransport.",
          "evidence": [
            {
              "path": "src/server.ts",
              "quote": "await createServer(store).connect(new StdioServerTransport())"
            }
          ]
        },
        {
          "id": "retrieval-limit",
          "statement": "MCP keyword search accepts a maximum limit of 20 facts.",
          "evidence": [
            {
              "path": "src/server.ts",
              "quote": "limit:z.number().int().min(1).max(20).optional()"
            }
          ]
        },
        {
          "id": "developer-approval",
          "statement": "CLI pillar approval requires the explicit --approve flag.",
          "evidence": [
            {
              "path": "src/cli.ts",
              "quote": "if(!approved)throw new Error('Developer approval required: inspect the proposal, then pass --approve.')"
            }
          ]
        },
        {
          "id": "tool-errors",
          "statement": "MCP tool failures return isError true with a JSON error message.",
          "evidence": [
            {
              "path": "src/server.ts",
              "quote": "return {...result({error:e.message}),isError:true};"
            }
          ]
        }
      ],
      "sources": {
        "src/cli.ts": "1ecec56661b558ed03654141d10c144f6e35d8362e0cbc594500d93172952a8c",
        "src/server.ts": "56b4c2041ee3ec915d51fd907de8ba171af5ae145eeb25368c4e43d3799e9314"
      }
    },
    {
